# Helius API key — get one free at https://dashboard.helius.dev
# Copy this file to .env.local and fill in your key. Used server-side only;
# it is never exposed to the browser. Also powers the /api/rpc proxy: set this (or MAINNET_RPC to a
# full URL), then point the mobile app at EXPO_PUBLIC_MAINNET_RPC=https://<your-app-host>/api/rpc so
# every user shares one dedicated RPC and the key never ships in the app.
HELIUS_API_KEY=
# Optional: a full server-side Solana RPC URL, used by /api/rpc and the liquidity/metadata backend.
# Takes precedence over HELIUS_API_KEY. e.g. https://mainnet.helius-rpc.com/?api-key=<key>
MAINNET_RPC=
# Optional server-side upstreams for the other networks /api/rpc proxies (all fall back to public):
DEVNET_RPC=
ETH_RPC=
BSC_RPC=

# 0x API key — get one free at https://dashboard.0x.org
# Powers the /api/0x proxy that adds 0x liquidity to the mobile swap comparison.
# Server-side only; the mobile app calls the proxy, never 0x directly.
# Then set EXPO_PUBLIC_ZEROX_PROXY=https://<your-app-host>/api/0x in mobile/.env
ZEROX_API_KEY=

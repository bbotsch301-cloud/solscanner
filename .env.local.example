# Helius API key — get one free at https://dashboard.helius.dev
# Copy this file to .env.local and fill in your key. Used server-side only;
# it is never exposed to the browser.
HELIUS_API_KEY=

# 0x API key — get one free at https://dashboard.0x.org
# Powers the /api/0x proxy that adds 0x liquidity to the mobile swap comparison.
# Server-side only; the mobile app calls the proxy, never 0x directly.
# Then set EXPO_PUBLIC_ZEROX_PROXY=https://<your-app-host>/api/0x in mobile/.env
ZEROX_API_KEY=

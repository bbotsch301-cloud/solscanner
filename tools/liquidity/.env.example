# Treasury LP ops — MAINNET. Copy to .env and fill in. NEVER commit .env.

# Treasury signer. Base58 secret key (Phantom "Export Private Key") OR a JSON
# byte array like [12,34,...]. This key controls real funds — keep it offline,
# use a dedicated ops machine, and consider a hardware/multisig setup instead.
TREASURY_SECRET_KEY=

# Mainnet RPC. The public endpoint is rate-limited; use a paid RPC (Helius,
# Triton, QuickNode) for pool creation.
MAINNET_RPC=https://api.mainnet-beta.solana.com

# Set per-command (or here) — see each script's header for what it reads.
# POOL_QUOTE=SOL          # SOL (default, primary pool) or USDC
# SEED_BASE=1000000       # XGO to seed
# SEED_QUOTE=90           # SOL (or USDC if POOL_QUOTE=USDC) — sets opening price
# POOL_ID=
# ADD_BASE=500000
# REMOVE_PCT=25
